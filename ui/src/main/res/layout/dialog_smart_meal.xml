<?xml version="1.0" encoding="utf-8"?>
<!--  res/layout/dialog_smart_meal.xml
      Place in:  ui/src/main/res/layout/dialog_smart_meal.xml  -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Header ──────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/si_dialog_title"
            android:textAppearance="@style/TextAppearance.AppCompat.Large"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- ── Meal mode spinner ────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/si_mode_label"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium" />

        <Spinner
            android:id="@+id/mode_spinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- ── Mode duration ────────────────────────────────────────────── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/si_duration_label"
            android:textAppearance="@style/TextAppearance.AppCompat.Medium" />

        <app.aaps.core.ui.elements.NumberPicker
            android:id="@+id/mode_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- ── Pre-bolus toggle ─────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/si_prebolus_label"
                android:textAppearance="@style/TextAppearance.AppCompat.Medium" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/pre_bolus_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- ── Pre-bolus amount (shown only when toggle is on) ──────────── -->
        <LinearLayout
            android:id="@+id/pre_bolus_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <app.aaps.core.ui.elements.NumberPicker
                android:id="@+id/pre_bolus_amount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp" />

            <!-- Quick-add buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal">

                <Button
                    android:id="@+id/bolus1"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+1" />

                <Button
                    android:id="@+id/bolus2"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+2" />

                <Button
                    android:id="@+id/bolus3"
                    style="@style/Widget.AppCompat.Button.Borderless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+3" />

            </LinearLayout>
        </LinearLayout>

        <!-- ── Cancel active mode ───────────────────────────────────────── -->
        <Button
            android:id="@+id/cancel_mode_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:backgroundTint="?attr/warningColor"
            android:text="@string/si_cancel_mode_label"
            android:visibility="gone" />

        <!-- ── OK / Cancel ──────────────────────────────────────────────── -->
        <include layout="@layout/okcancel" />

    </LinearLayout>
</ScrollView>