<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Overview card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Overview" android:textSize="20sp" android:textStyle="bold"
                    android:layout_marginBottom="16dp" />
                <LinearLayout android:id="@+id/general_rows" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Rebound / recovery card — visibility controlled programmatically -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/rebound_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Low Recovery" android:textSize="20sp" android:textStyle="bold"
                    android:textColor="#FFFB8C00"
                    android:layout_marginBottom="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Active protection window after a low BG event."
                    android:textSize="11sp" android:textColor="#FF888888" android:layout_marginBottom="16dp" />
                <LinearLayout android:id="@+id/rebound_rows" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TIR card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Time in Range" android:textSize="20sp" android:textStyle="bold"
                    android:layout_marginBottom="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="How much time BG has spent in the healthy range over the last 24h."
                    android:textSize="11sp" android:textColor="#FF888888" android:layout_marginBottom="16dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Fasting" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="20dp"
                    android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <View android:id="@+id/tir_fasting_low"  android:layout_width="0dp" android:layout_height="match_parent" android:background="#FFE53935" />
                    <View android:id="@+id/tir_fasting_in"   android:layout_width="0dp" android:layout_height="match_parent" android:background="#FF43A047" />
                    <View android:id="@+id/tir_fasting_high" android:layout_width="0dp" android:layout_height="match_parent" android:background="#FFFB8C00" />
                </LinearLayout>
                <TextView android:id="@+id/tv_tir_fasting_pct" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="12sp" android:layout_marginBottom="16dp"
                    tools:text="99% in range" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Meal" android:textSize="13sp" android:textStyle="bold" android:layout_marginBottom="6dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="20dp"
                    android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <View android:id="@+id/tir_meal_low"  android:layout_width="0dp" android:layout_height="match_parent" android:background="#FFE53935" />
                    <View android:id="@+id/tir_meal_in"   android:layout_width="0dp" android:layout_height="match_parent" android:background="#FF43A047" />
                    <View android:id="@+id/tir_meal_high" android:layout_width="0dp" android:layout_height="match_parent" android:background="#FFFB8C00" />
                </LinearLayout>
                <TextView android:id="@+id/tv_tir_meal_pct" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="12sp" tools:text="93% in range" />
                <TextView android:id="@+id/tv_tir_hba1c"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:layout_marginTop="10dp"
                    tools:text="Est. HbA1c: 6.2%  •  24h avg: 6.8 mmol/L" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Learning card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Learning" android:textSize="20sp" android:textStyle="bold"
                    android:layout_marginBottom="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="SmartInsulin adapts to your body over time using real BG data."
                    android:textSize="11sp" android:textColor="#FF888888" android:layout_marginBottom="16dp" />
                <LinearLayout android:id="@+id/learning_rows" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- UAM card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Meal Auto-Detection (UAM)" android:textSize="20sp" android:textStyle="bold"
                    android:layout_marginBottom="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Detects unannounced meals from unexpected BG rises."
                    android:textSize="11sp" android:textColor="#FF888888" android:layout_marginBottom="16dp" />
                <LinearLayout android:id="@+id/uam_rows" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- STFT card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Soft Target (STFT)" android:textSize="20sp" android:textStyle="bold"
                    android:layout_marginBottom="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Nudges the loop to correct stubborn high BG without changing your profile."
                    android:textSize="11sp" android:textColor="#FF888888" android:layout_marginBottom="16dp" />
                <LinearLayout android:id="@+id/stft_rows" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Circadian card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Circadian 24h" android:textSize="20sp" android:textStyle="bold"
                    android:layout_marginBottom="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Hourly multipliers learned from your BG patterns.\nISF× and Bas× = how much to adjust sensitivity and basal for that hour.\nCeil = aggressiveness cap — if the loop is being too aggressive for this hour, this number clamps it down. Lower = more conservative.\nConf = confidence — how much real data has been collected. Green ≥60%, amber ≥30%, red &lt;30%."
                    android:textSize="11sp" android:textColor="#FF888888" android:layout_marginBottom="12dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Hr"   android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:text="ISF×" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:text="Bas×" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_weight="2" android:layout_height="wrap_content" android:text="Ceil" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:layout_width="0dp" android:layout_weight="3" android:layout_height="wrap_content" android:text="Conf" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp" />
                <LinearLayout android:id="@+id/circadian_rows" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Insulin profiles card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Insulin Profiles" android:textSize="20sp" android:textStyle="bold"
                    android:layout_marginBottom="4dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Learned peak and duration per meal type. Green = learned, amber = learning, grey = using profile values."
                    android:textSize="11sp" android:textColor="#FF888888" android:layout_marginBottom="16dp" />
                <LinearLayout android:id="@+id/profile_rows" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Raw status log -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Raw Status Log" android:textSize="20sp" android:textStyle="bold"
                    android:layout_marginBottom="12dp" />
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:id="@+id/tv_status" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:fontFamily="monospace"
                        android:textSize="12sp" android:lineSpacingMultiplier="1.25" tools:text="Loading..." />
                </HorizontalScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Reset card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Reset Learners" android:textSize="20sp" android:textStyle="bold"
                    android:layout_marginBottom="16dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Aggressiveness score" android:textSize="16sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_reset_aggression"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="16sp" android:paddingStart="24dp" android:paddingEnd="24dp" android:text="Reset" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Basal multiplier" android:textSize="16sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_reset_basal"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="16sp" android:paddingStart="24dp" android:paddingEnd="24dp" android:text="Reset" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Circadian hourly learning" android:textSize="16sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_reset_circadian"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="16sp" android:paddingStart="24dp" android:paddingEnd="24dp" android:text="Reset" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="20dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="Insulin profiles (peak/DIA)" android:textSize="16sp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btn_reset_profiles"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="16sp" android:paddingStart="24dp" android:paddingEnd="24dp" android:text="Reset" />
                </LinearLayout>
                <com.google.android.material.divider.MaterialDivider android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginBottom="16dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btn_reset_all"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent" android:layout_height="56dp"
                    android:textSize="18sp" android:text="Reset ALL Learners" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>